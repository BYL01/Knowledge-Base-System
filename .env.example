# 复制成 .env 并填入真实值。默认的 hashing / extractive 后端不需要任何 key。

# DeepSeek：用于生成后端和 LLM 判官（DeepSeek 没有 embedding 接口，向量化仍走本地 hashing）
# 注意：这个文件不要提交到 git，服务器上给 600 权限。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 生成后端切到 openai 时需要（这条链路国内服务器不一定通，按需启用）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 向量库切到 chroma 时可指定持久化目录（默认沿用 configs/baseline.yaml 里的 store.path）
# CHROMA_PERSIST_DIR=

# 测试环境数据库：写操作落库校验 / 测试数据准备与清理时用，仅限测试环境。
# 真实值只放 .env，这个模板里一律留空。
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

# 测试服务器 SSH：本项目按私钥登录，没有密码项。
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
